{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/messages/playtest.request.json",
  "description": "Work item: run a test and collect results.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "playtest.request"
    },
    "playtest_id": {
      "$ref": "../common.json#/$defs/id"
    },
    "duration_limit_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "collect": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "output",
          "timings"
        ]
      }
    }
  },
  "required": [
    "type",
    "playtest_id",
    "duration_limit_s",
    "collect"
  ],
  "additionalProperties": false
}
