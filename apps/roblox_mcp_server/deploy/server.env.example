# Configure these values only for a separately provisioned disposable test universe/place.
RGA_ROBLOX_TEST_UNIVERSE_ID=
RGA_ROBLOX_TEST_PLACE_ID=
RGA_ROBLOX_TEST_PLACE_VERSION=
RGA_ROBLOX_PRODUCTION_UNIVERSE_IDS=
RGA_ROBLOX_PRODUCTION_PLACE_IDS=
RGA_ROBLOX_DISPOSABLE_CONFIRMED=
RGA_ROBLOX_PERSISTENCE_VERIFIED=
RGA_ROBLOX_PERSISTENCE_EVIDENCE=
ROBLOX_OPEN_CLOUD_API_KEY=
# Required for all modes. Generate a unique 32–512 character bearer token.
RGA_ROBLOX_MCP_TOKEN=
# Optional browser origins allowed to call this server. Leave empty for agent-only MCP clients.
RGA_ROBLOX_MCP_ALLOWED_ORIGINS=
RGA_ROBLOX_ASSET_CREATOR_TYPE=
RGA_ROBLOX_ASSET_CREATOR_ID=
ROBLOX_OPEN_CLOUD_ASSET_API_KEY=
RGA_ROBLOX_ASSET_CREATION_CONFIRMED=
RGA_ROBLOX_ASSET_APPROVAL_SECRET=
# Optional fixed Blender source for server-to-server, reviewed GLB transfer.
BLENDER_MCP_URL=
BLENDER_MCP_BEARER_TOKEN=
RGA_ROBLOX_BLENDER_TRANSFER_CONFIRMED=
RGA_ROBLOX_MODEL_TRANSFER_LEDGER=/var/lib/rga/model_transfers.sqlite3
RGA_ROBLOX_PLACE_PUBLISH_CONFIRMED=
ROBLOX_OPEN_CLOUD_PUBLISH_API_KEY=
RGA_ROBLOX_PUBLISH_APPROVAL_SECRET=
RGA_ROBLOX_PUBLISH_LEDGER=/var/lib/rga/place_publications.sqlite3
RGA_ROBLOX_MAX_GLB_BYTES=19922944
RGA_ROBLOX_ASSET_POLL_TIMEOUT_SECONDS=120
RGA_ROBLOX_TASK_TIMEOUT_SECONDS=60
RGA_ROBLOX_POLL_TIMEOUT_SECONDS=150
# Optional browser downloads. The TLS proxy must forward GET /downloads/*.
RGA_ROBLOX_DOWNLOAD_ORIGIN=
