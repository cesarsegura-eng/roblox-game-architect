# Copy to .env and fill in. Never commit .env.
# Nothing reads these yet: no engine and no API service exist. They are the
# contract the implementation is to be written against.
#
# ---------- LLM provider ----------
# The core engine talks to an LLM through its own provider interface (ADR-0003),
# so the key and the model id are generic: the adapter decides what they mean.
# Keys are held by the API service only, never by the Studio plugin (ADR-0005).
LLM_PROVIDER=fake
# Ignored while LLM_PROVIDER=fake.
LLM_API_KEY=
# ADR-0003 requires an exact model id, never a moving alias, so that a
# provider-side change cannot silently alter the agent's behaviour.
LLM_MODEL_ID=

# ---------- Budget limits (see ADR-0002) ----------
# Hard stops for the autonomous design -> build -> test -> improve loop.
AGENT_MAX_ITERATIONS=10
AGENT_MAX_USD_PER_SESSION=1.00

# ---------- API service ----------
# Bound to loopback: the plugin reaches it from the same machine, and nothing
# else should (ADR-0007 — the plugin always initiates, so the service needs no
# inbound reachability from outside).
API_HOST=127.0.0.1
API_PORT=8000
# Shared secret the Studio plugin uses to authenticate against the local API.
# An empty value must fail closed: no token means no authentication means the
# service refuses to start, never "allow everything".
PLUGIN_AUTH_TOKEN=

# ---------- Storage ----------
# Where generated projects are written. Ignored by git.
DATA_DIR=./data
