{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/messages/session.hello.response.json",
  "description": "API to plugin. Accepts the session. The new session_id is in the envelope.",
  "type": "object",
  "properties": {
    "negotiated": {
      "$ref": "../common.json#/$defs/negotiated_version"
    },
    "server": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "negotiated",
    "server"
  ],
  "additionalProperties": false
}
