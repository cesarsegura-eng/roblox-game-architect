{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/messages/session.hello.request.json",
  "description": "Plugin to API. Opens a session and negotiates the version. Immutable (ADR-0009).",
  "type": "object",
  "properties": {
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "supported": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "../common.json#/$defs/version_range"
      }
    }
  },
  "required": [
    "client",
    "supported"
  ],
  "additionalProperties": false
}
