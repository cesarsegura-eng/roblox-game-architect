{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/envelope.hello.request.json",
  "description": "Envelope of session.hello requests. No session_id exists yet. Framing frozen at 1.0.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "common.json#/$defs/hello_protocol_version"
    },
    "kind": {
      "type": "string",
      "const": "request"
    },
    "type": {
      "type": "string",
      "const": "session.hello"
    },
    "message_id": {
      "$ref": "common.json#/$defs/id"
    },
    "sent_at": {
      "$ref": "common.json#/$defs/timestamp_ms"
    },
    "payload": {
      "description": "Opaque at this stage. Validated in stage 2 against the payload schema selected by type, kind and status (docs/protocol/README.md)."
    }
  },
  "required": [
    "protocol_version",
    "kind",
    "type",
    "message_id",
    "payload"
  ],
  "additionalProperties": false
}
