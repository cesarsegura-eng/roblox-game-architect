{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/envelope.request.json",
  "description": "Envelope of every request except session.hello.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "common.json#/$defs/protocol_version"
    },
    "kind": {
      "type": "string",
      "const": "request"
    },
    "type": {
      "type": "string",
      "enum": [
        "work.poll",
        "project.state",
        "edit.result",
        "playtest.report"
      ]
    },
    "message_id": {
      "$ref": "common.json#/$defs/id"
    },
    "session_id": {
      "$ref": "common.json#/$defs/id"
    },
    "sent_at": {
      "$ref": "common.json#/$defs/timestamp_ms"
    },
    "payload": {
      "description": "Opaque at this stage. Validated in stage 2 against the payload schema selected by type, kind and status (docs/protocol/README.md)."
    }
  },
  "required": [
    "protocol_version",
    "kind",
    "type",
    "message_id",
    "session_id",
    "payload"
  ],
  "additionalProperties": false
}
