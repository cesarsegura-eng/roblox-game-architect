{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/envelope.hello.response.json",
  "description": "Envelope of session.hello responses. An accepted hello carries the new session_id; a failed one carries none. Framing frozen at 1.0.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "$ref": "common.json#/$defs/hello_protocol_version"
        },
        "kind": {
          "type": "string",
          "const": "response"
        },
        "type": {
          "type": "string",
          "const": "session.hello"
        },
        "message_id": {
          "$ref": "common.json#/$defs/id"
        },
        "correlation_id": {
          "$ref": "common.json#/$defs/id"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "sent_at": {
          "$ref": "common.json#/$defs/timestamp_ms"
        },
        "payload": {
          "description": "Opaque at this stage. Validated in stage 2 against the payload schema selected by type, kind and status (docs/protocol/README.md)."
        },
        "session_id": {
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "protocol_version",
        "kind",
        "type",
        "message_id",
        "correlation_id",
        "status",
        "payload",
        "session_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
