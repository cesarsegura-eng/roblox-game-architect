{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/roblox-game-architect/protocol/v1/messages/edit.action.json",
  "description": "Work item: one validated, approved change, delivered in a work.poll response. The property allowlist is this file's set_property_* definitions and nothing else.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "edit.action"
    },
    "action_id": {
      "$ref": "../common.json#/$defs/id"
    },
    "declared_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "../common.json#/$defs/scope_entry"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "required": [
    "type",
    "action_id",
    "declared_scope",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "create_instance": {
      "description": "Creates an instance. Never carries source. Script and LocalScript are created disabled by the plugin (ADR-0008).",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "create_instance"
        },
        "op_id": {
          "$ref": "../common.json#/$defs/id"
        },
        "parent": {
          "$ref": "../common.json#/$defs/instance_ref"
        },
        "name": {
          "$ref": "../common.json#/$defs/segment"
        },
        "class_name": {
          "$ref": "../common.json#/$defs/creatable_class"
        }
      },
      "required": [
        "op",
        "op_id",
        "parent",
        "name",
        "class_name"
      ],
      "additionalProperties": false
    },
    "set_script_source": {
      "description": "Replaces the whole source. Applied with ScriptEditorService:UpdateSourceAsync.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set_script_source"
        },
        "op_id": {
          "$ref": "../common.json#/$defs/id"
        },
        "target": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "../common.json#/$defs/path"
            },
            "expect_class": {
              "$ref": "../common.json#/$defs/script_class"
            }
          },
          "required": [
            "path",
            "expect_class"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "op",
        "op_id",
        "target",
        "source"
      ],
      "additionalProperties": false
    },
    "reparent": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "reparent"
        },
        "op_id": {
          "$ref": "../common.json#/$defs/id"
        },
        "target": {
          "$ref": "../common.json#/$defs/instance_ref"
        },
        "new_parent": {
          "$ref": "../common.json#/$defs/instance_ref"
        }
      },
      "required": [
        "op",
        "op_id",
        "target",
        "new_parent"
      ],
      "additionalProperties": false
    },
    "delete_instance": {
