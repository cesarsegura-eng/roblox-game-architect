# Copy to .env and fill in. Never commit .env.
# packages/core has code to read LLM_PROVIDER, AGENT_MAX_ITERATIONS and
# AGENT_MAX_USD_PER_SESSION from the process environment. Nothing loads this
# example file automatically; copy its values into the process environment.
# The operator CLI and API read only the settings they need.
#
# ---------- LLM provider ----------
# The core engine talks to an LLM through its own provider interface (ADR-0003),
# Keys stay in the operator/API process, never in Blender or the Studio plugin.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Only this model currently has a verified price in the spend guard.
LLM_MODEL_ID=claude-sonnet-5-5

# ---------- Budget limits (see ADR-0002) ----------
# Hard stops for the autonomous design -> build -> test -> improve loop.
# Read by core (IterationBudget). Unset means 10; a value that is set but empty
# or not a positive integer is an error, never the default.
AGENT_MAX_ITERATIONS=10
# Read by SpendBudget.from_env(): unset means 1.00 USD; an invalid value fails
# closed. A real adapter must provide a reliable maximum-cost quote.
# A paid call without a reliable maximum-cost quote is refused.
AGENT_MAX_USD_PER_SESSION=1.00

# ---------- API service ----------
# The HTTP service always binds to 127.0.0.1 (loopback).
API_PORT=8787
# Shared secret the Studio plugin uses to authenticate against the local API.
# Requires 32-512 printable ASCII characters. The server refuses to start
# without it and checks it on every plugin-channel request.
PLUGIN_AUTH_TOKEN=
# Separate credential for the local web operator panel. Leave blank to disable it.
# Requires 32-512 printable ASCII characters. The browser keeps it in memory only.
OPERATOR_AUTH_TOKEN=
# Separate bearer token for the optional, loopback-only Blender generation route.
# Requires 32-512 printable ASCII characters; use a long random value and put it in
# both this API process and Blender's add-on preferences. The web operator can also
# generate recipes with OPERATOR_AUTH_TOKEN and a real LLM provider configured.
BLENDER_AUTH_TOKEN=
# Optional remote Blender MCP Streamable HTTP endpoint. This is the MCP server
# on a separate host with a running Blender instance; the user's PC needs no
# Blender installation for this remote route. It must expose the restricted
# rga_apply_scene_recipe tool documented in docs/integrations/blender-remote-mcp.md.
# Remote endpoints require HTTPS and a 32-512 character bearer token.
BLENDER_MCP_URL=
BLENDER_MCP_BEARER_TOKEN=
# Optional remote Roblox MCP endpoint on a separate server. This is the
# application-side route: the user's computer does not need Roblox Studio.
# The server requires a pinned disposable test place and server-side Open Cloud
# key; it exposes fixed validated tools, never arbitrary Luau. The optional
# local Studio plugin is a compatibility/inspection route, not a prerequisite.
ROBLOX_MCP_URL=
ROBLOX_MCP_BEARER_TOKEN=
# Shared only by this API and the separate Roblox MCP server. Approval secrets
# sign exact asset or place digests and are never sent to Roblox.
RGA_ROBLOX_ASSET_APPROVAL_SECRET=
RGA_ROBLOX_PUBLISH_APPROVAL_SECRET=
# These IDs must match the disposable target configured on the remote server.
RGA_ROBLOX_TEST_UNIVERSE_ID=
RGA_ROBLOX_TEST_PLACE_ID=

# ---------- Storage ----------
# Where generated projects are written. Ignored by git.
DATA_DIR=./data
