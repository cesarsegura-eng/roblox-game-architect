{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roblox-game-architect:release-readiness-v1",
  "title": "Roblox Game Architect Release Readiness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_title",
    "readiness",
    "verified_gate_count",
    "pending_gate_count",
    "notice",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "readiness": { "const": "not_ready" },
    "verified_gate_count": { "const": 0 },
    "pending_gate_count": { "const": 9 },
    "notice": { "type": "string", "minLength": 1, "maxLength": 500 },
    "gates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner_role",
          "applicability",
          "status",
          "verification_method",
          "evidence_required",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "release_scope",
              "server_authority_and_abuse",
              "persistence_and_recovery",
              "commerce_and_policy",
              "multiplayer_and_network",
              "device_playability_and_performance",
              "content_rights_and_safety",
              "operations_and_rollback",
              "human_release_approval"
            ]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "owner_role": { "type": "string", "minLength": 1, "maxLength": 80 },
          "applicability": {
            "enum": ["required", "likely_in_scope", "owner_scope_decision_required"]
          },
          "status": { "const": "pending" },
          "verification_method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "evidence": { "type": "array", "maxItems": 0 }
        }
      }
    }
  }
}
